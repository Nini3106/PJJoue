{
  "name": "pjjoue-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz CJPM V1 — parcours, couleurs contextuelles et lecture confortable ; aperçu local à valider",
  "scripts": {
    "dev": "node outils/serveur-previsualisation.js",
    "test": "npm run controle:syntaxe && npm run controle:css && npm run test:logique && npm run test:socle-atlas && npm run controle:accessibilite && npm run controle:navigation-libre && npm run test:interface && npm run test:atlas && npm run test:atlas-v1-couleurs && npm run test:finitions-v1",
    "controle:javascript": "eslint ressources/*.js",
    "controle:css": "npm run controle:css:doublons && npm run controle:css:structure",
    "controle:css:doublons": "node outils/controler_css.js doublons",
    "controle:css:structure": "node outils/controler_css.js structure",
    "test:unitaire": "python tests/verifier_socle_atlas.py",
    "test:structure": "python tests/verifier_pjjoue.py",
    "test:interface": "python tests/verifier_interface.py",
    "controle:accessibilite": "python outils/auditer_accessibilite_statique.py",
    "controle:sources": "python outils/verifier_fraicheur_sources.py",
    "controle:liens": "python outils/verifier_liens_officiels.py",
    "test:visuel": "python tests/verifier_atlas.py --captures",
    "build:donnees": "python outils/construire_donnees.py",
    "build:seo": "python outils/construire_seo.py",
    "build:manifeste": "python outils/construire_manifeste.py",
    "build:site": "python outils/construire_site.py",
    "pretest": "npm run controle:noms-fichiers && npm run controle:donnees && npm run controle:construction && npm run controle:seo && npm run controle:manifeste",
    "controle:donnees": "python outils/construire_donnees.py --verifier",
    "controle:construction": "python outils/construire_site.py --verifier",
    "controle:seo": "python outils/construire_seo.py --verifier",
    "controle:navigation-libre": "python tests/verifier_navigation_libre.py",
    "controle:couleurs-icones": "python tests/verifier_couleurs_icones.py",
    "controle:identite-v1": "python tests/verifier_identite_v1.py",
    "test:pages-annexes": "python tests/verifier_pages_annexes.py",
    "test:sigles": "python tests/verifier_jeu_sigles.py",
    "controle:noms-fichiers": "python outils/verifier_noms_fichiers.py",
    "controle:manifeste": "python outils/construire_manifeste.py --verifier",
    "archive:utf8": "python outils/creer_archive_utf8.py",
    "test:logique": "node --test tests/logique/*.test.cjs",
    "test:historique-avant-atlas": "npm run controle:javascript && npm run controle:css && npm run test:logique && npm run test:unitaire:historique && npm run controle:accessibilite && npm run controle:sources && python tests/verifier_pjjoue.py && npm run controle:navigation-libre && npm run controle:couleurs-icones && npm run controle:identite-v1 && npm run test:visuel:historique && npm run test:pages-annexes && npm run test:interface && npm run test:sigles",
    "controle:syntaxe": "node outils/verifier_syntaxe_javascript.js",
    "test:socle-atlas": "python tests/verifier_socle_atlas.py",
    "test:atlas": "python tests/verifier_atlas.py",
    "captures:atlas": "python tests/verifier_atlas.py --captures",
    "essayer": "node outils/essayer_atlas.js",
    "test:unitaire:historique": "python -m unittest discover -s tests -p test_*.py",
    "test:visuel:historique": "python tests/verifier_regression_visuelle.py",
    "test:atlas-v1-couleurs": "python tests/verifier_atlas_v1_couleurs.py",
    "test:finitions-v1": "python tests/verifier_finitions_v1.py"
  },
  "keywords": [
    "PJJ",
    "formation",
    "jeu-pedagogique"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || ^22.13.0 || >=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10 <12",
      "onFail": "error"
    }
  }
}
